# =====================================================================
# .env.example  —  実際の .env の雛形 (キー名のみ / 値はプレースホルダ)
# 使い方: このファイルを .env にコピーし、各値を自分の環境に合わせて設定。
#   cp .env.example .env
# ※ .env は .gitignore で除外済み。実キーをコミットしないこと。
# =====================================================================

# --- LLM / 外部API キー (必須: 使用するプロバイダの分だけ) ---
OPENAI_API_KEY=your-openai-api-key-here          # judge_llm(gpt-4o) で全 shapley 版が使用
ANTHROPIC_API_KEY=your-anthropic-api-key-here    # claude 版 / router.py
GOOGLE_API_KEY=your-google-api-key-here          # gemini / gemma 版
OPENWEATHER_API_KEY=your-openweather-api-key-here # weather_tool
DEEPSEEK_API_KEY=your-deepseek-api-key-here       # (任意)

# --- モデル選択 (任意: 未設定ならコード内の既定値が使われる) ---
# OLLAMA_MODEL=llama3.1
# OLLAMA_MODEL_BASE=llama3.1
# OLLAMA_MODEL_TARGET=qwen2.5:32b
# OPENAI_MODEL=gpt-4o
# GOOGLE_MODEL=gemini-2.0-flash

# --- Google Calendar 関連 (google_calendar_api.py / config.py, 任意) ---
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
# GOOGLE_CALENDAR_CREDENTIALS_JSON=credentials.json
